    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.groq_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.groq_chat_model, temperature: 0.5, messages: [ { role: 'system', content: 'You are a helpful research assistant. Answer concisely in the same language as the user. Use web search when you need current information.' }, { role: 'user', content: $('Route').first().json.message.text } ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "0f2a5740-ab81-4d23-8d8b-2998d7e5c4bb",
      "name": "Chat AI (Groq)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        140
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegram_chat_id }}",
        "text": "={{ String($json.choices[0].message.content).slice(0, 4000) }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "d72f44a0-f9fc-48bc-8e78-2c56441402c7",
      "name": "Reply Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1580,
        140
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet query = j.default_query, location = j.default_location;\nif (j.message && j.message.text) {\n  const t = j.message.text.replace(/^\\/leads/i, '').trim();\n  if (t) { const p = t.split('|').map(s => s.trim()); query = p[0] || query; location = p[1] || location; }\n}\nreturn [{ json: { query, location } }];"
      },
      "id": "2f9daac8-3d66-478c-8e07-16aeefc40f75",
      "name": "Parse Lead Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $('Config').first().json.apify_actor }}/run-sync-get-dataset-items?token={{ $('Config').first().json.apify_token }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ searchStringsArray: [$json.query], locationQuery: $json.location, maxCrawledPlacesPerSearch: Number($('Config').first().json.max_places), language: 'en', scrapeContacts: true }) }}",
        "options": {
          "timeout": 330000
        }
      },
      "id": "3ad9e96f-2c81-417d-af5f-a8e4a2310a3a",
      "name": "Apify Google Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1580,
        420
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegram_chat_id }}",
        "text": "={{ 'Lead search failed. Check Apify token / credits.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "3730df78-e22a-4fa8-8f53-d7b69d0e7bb4",
      "name": "Notify Search Failed",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1580,
        600
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set(); const out = [];\nfor (const it of $input.all()) {\n  const p = it.json;\n  const emails = Array.isArray(p.emails) ? p.emails : (p.email ? [p.email] : []);\n  const email = String(emails.find(e => /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(e))) || '').toLowerCase();\n  if (!email || seen.has(email) || /\\.(png|jpe?g|gif|webp|svg)$/.test(email)) continue;\n  seen.add(email);\n  out.push({ json: { email, name: p.title || p.name || '', website: p.website || '', phone: p.phone || '', address: p.address || '', category: p.categoryName || '' } });\n}\nreturn out;"
      },
      "id": "17b3c9c2-d50f-4079-bd80-490dd22b7704",
      "name": "Extract Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        420
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheet_name }}",
          "mode": "name"
        },
        "options": {}
      },
      "id": "e258a59d-0ac0-4899-a81b-b5b89ae70dc1",
      "name": "Read Existing Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2100,
        420
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const existing = new Set($input.all().map(i => String(i.json.email || '').toLowerCase()).filter(Boolean));\nconst limit = Number($('Config').first().json.daily_limit) || 20;\nconst leads = $('Extract Leads').all().map(i => i.json).filter(l => !existing.has(l.email)).slice(0, limit);\nreturn leads.map(l => ({ json: l }));"
      },
      "id": "8be6dfe1-c7b6-4dc8-9e25-0de549c7d005",
      "name": "Dedupe & Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2360,
        420
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "c4ba7327-d6c8-472c-9543-1755cae35e3d",
      "name": "Loop Over Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        2620,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.groq_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.groq_email_model, temperature: 0.7, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You write short, friendly, personalized cold emails (max 90 words). No hype, no false claims, no links. Reply with JSON only: {\"subject\":\"...\",\"body\":\"...\"}. Do not add a signature.' }, { role: 'user', content: `Sender: ${$('Config').first().json.sender_name} from ${$('Config').first().json.company}. What we offer: ${$('Config').first().json.offer}. Recipient business: ${$json.name} (${$json.category}), website ${$json.website}, address ${$json.address}. Write the email in ${$('Config').first().json.email_language}.` } ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "7f8d2190-cb19-4729-b8a5-f73addd996c6",
      "name": "Write Email (Groq)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        520
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const c = $('Config').first().json;\nconst lead = $('Loop Over Leads').first().json;\nconst r = $input.first().json;\nlet subject = 'Quick question', body = '';\ntry { const m = JSON.parse(r.choices[0].message.content); subject = m.subject || subject; body = m.body || ''; } catch (e) {}\nif (!body) throw new Error('AI returned an empty email for ' + lead.email);\nbody += '\\n\\n' + c.sender_name + '\\n\\nP.S. If you would rather not hear from me, just reply \"unsubscribe\" and I will not contact you again.';\nreturn [{ json: { to: lead.email, subject, body, lead } }];"
      },
      "id": "eb7a32eb-7c42-4d46-9822-b5517bfbfde3",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3140,
        520
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "c04d9462-13ee-4cb7-81a5-643da0df441b",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        3400,
        520
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst b = $('Build Email').first().json;\nconst failed = !!e.error;\nreturn [{ json: { email: b.to, name: b.lead.name, website: b.lead.website, phone: b.lead.phone, address: b.lead.address,\n  subject: b.subject, status: failed ? 'failed' : 'sent', sent_at: new Date().toISOString(), threadId: e.threadId || '',\n  error: failed ? JSON.stringify(e.error).slice(0, 200) : '' } }];"
      },
      "id": "70bf533b-7691-4a04-8b70-900880c4f30c",
      "name": "Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3660,
        520
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheet_id }}",
